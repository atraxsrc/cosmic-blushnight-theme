# BlushNight for Ghostty, part of cosmic-blushnight-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = BlushNight
# or, with the Blush half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:BlushNight,light:Blush

background = #17130E
foreground = #DACCBC

cursor-color = #CD7F8B
cursor-text = #17130E

selection-background = #3F3B36
selection-foreground = #DACCBC

split-divider-color = #66615A
unfocused-split-fill = #17130E

