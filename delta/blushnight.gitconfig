# BlushNight for delta (the git diff pager), part of cosmic-blushnight-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat BlushNight theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/blushnight.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = blushnight

[delta "blushnight"]
    dark = true
    syntax-theme = BlushNight
    navigate = true
    line-numbers = true

    file-style = bold "#CD7F8B"
    file-decoration-style = "#66615A" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#66615A" box
    hunk-header-file-style = "#9A958E"
    hunk-header-line-number-style = "#B09282"

    minus-style = "#E8735E" "#25211D"
    minus-emph-style = bold "#17130E" "#E8735E"
    minus-non-emph-style = "#E8735E" "#25211D"
    plus-style = "#AE9B84" "#25211D"
    plus-emph-style = bold "#17130E" "#AE9B84"
    plus-non-emph-style = "#AE9B84" "#25211D"
    zero-style = syntax
    whitespace-error-style = "#17130E" "#D48F5E"

    line-numbers-left-style = "#66615A"
    line-numbers-right-style = "#66615A"
    line-numbers-minus-style = "#E8735E"
    line-numbers-plus-style = "#AE9B84"
    line-numbers-zero-style = "#66615A"

    commit-style = bold "#B09282"
    commit-decoration-style = "#66615A" box
    blame-palette = "#17130E #25211D #312D28"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#AE9B84"
    merge-conflict-theirs-diff-header-style = bold "#D48F5E"
