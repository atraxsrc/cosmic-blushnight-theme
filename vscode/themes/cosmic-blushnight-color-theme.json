        "markup.quote",
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#B3ADA6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "List marker",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list.markdown",
        "markup.list.numbered punctuation.definition",
        "markup.list.unnumbered punctuation.definition"
      ],
      "settings": {
        "foreground": "#858079"
      }
    },
    {
      "name": "Link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#9A958E",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Link text",
      "scope": [
        "string.other.link.title.markdown",
        "string.other.link.description.markdown",
        "string.other.link.description.title.markdown"
      ],
      "settings": {
        "foreground": "#9A958E"
      }
    },
    {
      "name": "Separator",
      "scope": [
        "meta.separator.markdown",
        "punctuation.definition.thematic-break"
      ],
      "settings": {
        "foreground": "#66615A"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#AE9B84"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#CD7F8B"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#D48F5E"
      }
    },
    {
      "name": "Diff range",
      "scope": [
        "meta.diff.range",
        "meta.diff.header",
        "meta.diff.index"
      ],
      "settings": {
        "foreground": "#9A958E"
      }
    },
    {
      "name": "Git commit subject",
      "scope": [
        "meta.scope.message.git-commit",
        "markup.heading.git-commit"
      ],
      "settings": {
        "foreground": "#DACCBC"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#9A958E",
    "type": "#9A958E",
    "class": "#9A958E",
    "struct": "#9A958E",
    "enum": "#9A958E",
    "interface": "#9A958E",
    "typeParameter": "#9A958E",
    "builtinType": "#9A958E",
    "function": "#B09282",
    "method": "#B09282",
    "macro": "#B38F7F",
    "decorator": "#B38F7F",
    "parameter": {
      "foreground": "#B3ADA6",
      "italic": true
    },
    "variable": "#DACCBC",
    "property": "#DACCBC",
    "enumMember": "#D48F5E",
    "event": "#DACCBC",
    "label": "#CD7F8B",
    "keyword": "#CD7F8B",
    "selfKeyword": "#B38F7F",
    "selfParameter": "#B38F7F",
    "selfTypeKeyword": "#9A958E",
    "builtinConstant": "#D48F5E",
    "lifetime": {
      "foreground": "#B38F7F",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
